collection users {
	auth: true;
	fields {
		first_name: text;
		last_name: text;
		email: email @unique;
		password: password;
		role: select("admin", "user") @default("user");
	}
	access {
		read: true;
		create: true;
		update: user.id == id || user.role == "admin";
		delete: user.role == "admin";
	}
}
